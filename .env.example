# Copy this file to .env (in the hw4/ folder) and fill in your own values.
# Never commit your real .env file.

# Required: Portkey API key used to call the gpt-5.6-luna model.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: signs login cookies so logins survive server restarts.
# Any long random string works (e.g. output of: python3 -c "import secrets; print(secrets.token_hex(32))").
SESSION_SECRET=replace-with-a-long-random-string

# Optional overrides (defaults shown).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CAMPUS_DB=/absolute/path/to/campus_customs.db       (default: hw4/data/campus_customs.db)
# AUDIT_TRAIL_PATH=/absolute/path/to/audit_trail.json  (default: hw4/output/audit_trail.json)
